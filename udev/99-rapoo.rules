# Rapoo Gaming Devices (VID 0x24AE) - rapoodriver4linux
#
# Da acesso sem privilegio aos nos /dev/hidraw* da Rapoo, necessario para:
#   - o CLI rapooctl (drivers/rapoodriver4linux)
#   - o web driver oficial da Rapoo (hub.rapoo.com) via WebHID
#
# Instalacao:
#   sudo cp udev/99-rapoo.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
#   (depois desconecte e reconecte o dongle 2.4GHz ou o cabo USB)

# Mouses USB (cabo) e receptores 2.4GHz (dongle)
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="24ae", MODE="0666", TAG+="uaccess"

# Mouses via Bluetooth (tipo de bus 0005; nomes de kernel usam hex maiúsculo,
# ex.: 0005:24AE:1421.0001 - mantemos também a variante minúscula por segurança)
SUBSYSTEM=="hidraw", KERNELS=="0005:24AE:*", MODE="0666", TAG+="uaccess"
SUBSYSTEM=="hidraw", KERNELS=="0005:24ae:*", MODE="0666", TAG+="uaccess"
